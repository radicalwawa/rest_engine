  "actions": [
    {
      "key": "kick_sub_uyumu",
      "when_below": 7,
      "prompt_append_tr": "Düşük frekansları kulüp güvenli yap: sub baskısı güçlü ama taşmasın; kick net ve kısa; low-end temiz, bulanık olmasın.",
      "tighten": {
        "mix_targets.kick_sub_relationship": "club_safe",
        "mix_targets.transients": "tight"
      },
      "loosen": null
    },
    {
      "key": "vokal_alani",
      "when_below": 7,
      "prompt_append_tr": "Vokale daha fazla boşluk bırak: element sayısını azalt; orta frekansta çakışma olmasın; vokal önde kalsın.",
      "tighten": {
        "suno_prompt_guidelines.focus_add": ["space for vocal", "fewer elements"],
        "suno_prompt_guidelines.avoid_add": ["busy mids", "dense arrangement"]
      },
      "loosen": null
    },
    {
      "key": "renk_safligi",
      "when_below": 8,
      "prompt_append_tr": "Renk safliğini artır: bu state dışına kayma; genre_stack'e sadık kal; 'avoid' listesini kesin uygula; pop/EDM hissi verme.",
      "tighten": {
        "suno_prompt_guidelines.enforce_avoid": true
      },
      "loosen": null
    },
    {
      "key": "akis_dj_uygunlugu",
      "when_below": 7,
      "prompt_append_tr": "DJ akışını güçlendir: drop olmasın; loop sürekliliği olsun; sert geçiş yok; baskı kademeli artsın.",
      "tighten": {
        "suno_prompt_guidelines.allow_drop": false
      },
      "loosen": null
    },
    {
      "key": "minimalizm_disiplini",
      "when_below": 6,
      "prompt_append_tr": "Daha minimal ol: daha az element; tek omurga loop; gereksiz melodik süsleme yok; sade ama ağır.",
      "tighten": {
        "suno_prompt_guidelines.focus_add": ["minimal elements", "single backbone loop"],
        "suno_prompt_guidelines.avoid_add": ["extra melodies", "too many layers"]
      },
      "loosen": null
    },
    {
      "key": "enerji_egrisi",
      "when_below": 7,
      "prompt_append_tr": "Enerji eğrisini düzelt: monoton olmasın ama drop da olmasın; küçük katman eklemeleriyle baskı artışı yarat.",
