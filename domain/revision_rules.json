        "energy_curve_hint": "small_layered_pressure_ramp"
      },
      "loosen": null
    },
    {
      "key": "tekrar_dinlenebilirlik",
      "when_below": 7,
      "prompt_append_tr": "Tekrar dinlenebilirliği artır: daha az yoran üst frekans; daha temiz yapı; hook/loop daha net, rahatsız edici değil.",
      "tighten": {
        "fx_policy.brightness": "low_to_moderate",
        "suno_prompt_guidelines.avoid_add": ["harsh highs", "fatiguing top end"]
      },
      "loosen": null
    }
