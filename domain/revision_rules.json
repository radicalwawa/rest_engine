  "selection_policy": {
    "max_actions_per_revision": 2,
    "priority": ["renk_safligi", "kick_sub_uyumu", "vokal_alani", "akis_dj_uygunlugu", "minimalizm_disiplini", "enerji_egrisi", "tekrar_dinlenebilirlik"],
