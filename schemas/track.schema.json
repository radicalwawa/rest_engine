{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rest_engine/schemas/track.schema.json",
  "title": "REST Track Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "theme",
    "energy_profile",
    "emotional_tone",
    "lyrical_focus",
    "keyword_vector",
    "techno_profile",
    "constraints",
    "calibration",
    "library_binding"
  ],
  "properties": {
    "id": {
      "type": "string",
      "enum": [
        "radical.grey",
        "radical.blue",
        "radical.green",
        "radical.cream",
        "radical.black"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "theme": { "type": "string" },
    "energy_profile": { "type": "string" },
    "emotional_tone": { "type": "string" },
    "lyrical_focus": { "type": "string" },
    "keyword_vector": {
      "type": "array",
      "items": { "type": "string" }
    },
    "techno_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "drive_level",
        "bass_weight",
        "texture_type",
        "spatial_depth"
      ],
      "properties": {
        "drive_level": { "type": "string" },
        "bass_weight": { "type": "string" },
        "texture_type": { "type": "string" },
        "spatial_depth": { "type": "string" }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bpm_override", "structure_override"],
      "properties": {
        "bpm_override": { "type": ["integer", "null"] },
        "structure_override": { "type": ["string", "null"] }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tested_bpms", "proven_bpm", "drift_notes"],
      "properties": {
        "tested_bpms": {
          "type": "array",
          "items": { "type": "integer" }
        },
        "proven_bpm": { "type": ["integer", "null"] },
        "drift_notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "library_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kick", "bass", "hat", "lead", "texture"],
      "properties": {
        "kick": { "type": "string" },
        "bass": { "type": "string" },
        "hat": { "type": "string" },
        "lead": { "type": "string" },
        "texture": { "type": "string" }
      }
    }
  }
}
