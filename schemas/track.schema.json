{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "track.schema.json",
  "title": "Track",
  "description": "Schema for a track resource",
  "type": "object",
  "properties": {
    "id": { "type": "string", "description": "Unique track identifier" },
    "name": { "type": "string", "description": "Track name" },
    "artist": { "type": "string", "description": "Artist name" },
    "duration": { "type": "number", "minimum": 0, "description": "Duration in seconds" },
    "url": { "type": "string", "format": "uri", "description": "Optional URL" }
  },
  "additionalProperties": true
}
